{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "stock-widget-tray",
  "version": "0.1.0",
  "identifier": "com.tauri-app.stock-widget-tray",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "自选 · 小窗看盘",
        "width": 430,
        "height": 300,
        "minWidth": 360,
        "minHeight": 250,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "resources": ["resources/server.py"],
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
